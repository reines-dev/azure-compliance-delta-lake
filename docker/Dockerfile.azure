# Dockerfile híbrido: Construye la Function de Azure
FROM mcr.microsoft.com/azure-functions/python:4-python3.12

# Variables de entorno
ENV AzureWebJobsScriptRoot=/home/site/wwwroot \
    AzureFunctionsJobHost__Logging__Console__IsEnabled=true

# Instalar dependencias del sistema requeridas por DeltaLake
RUN apt-get update && \
    apt-get install -y build-essential gcc g++ && \
    apt-get clean

# Copiar archivos
COPY requirements.txt /
COPY requirements-azure.txt /

# Instalar dependencias puras y de Azure
RUN pip install -r /requirements.txt && \
    pip install -r /requirements-azure.txt

# Copiar código fuente al wwwroot de azure
# Movemos lo necesario a la raiz para que Func lo encuentre
COPY src/ /home/site/wwwroot/src/
COPY cloud/azure/function_app.py /home/site/wwwroot/function_app.py
COPY cloud/azure/host.json /home/site/wwwroot/host.json

WORKDIR /home/site/wwwroot
