{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "SAMDeployRequirements",
            "Effect": "Allow",
            "Action": [
                "cloudformation:*",
                "s3:*",
                "iam:*",
                "lambda:*",
                "ecr:*",
                "apigateway:*",
                "states:*",
                "events:*",
                "glue:*"
            ],
            "Resource": "*"
        }
    ]
}